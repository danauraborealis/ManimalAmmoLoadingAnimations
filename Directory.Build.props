<Project>
  <!--
    Single source of truth for the mod version + GUID. update ModVersion here
    and every place that uses it (BepInPlugin attribute, server ModMetadata,
    csproj Version, release zip filename) refreshes on next build.
  -->
  <PropertyGroup>
    <ModVersion>2.0.1</ModVersion>
    <ModSptVersion>~4.1.5</ModSptVersion>
    <ModGuid>com.manimal.loadammoanim</ModGuid>
    <!-- custom item parent id. matches [CustomParent] on LoadAmmoBundleItem and the
         "parentId" field in hidden_anim_STANAGS.jsonc. random 24-hex, distinct from
         every other mod's parent id so theres no collision. -->
    <ModBundleItemParentId>8a3f72c1b9d5e60a4fe83b21</ModBundleItemParentId>
  </PropertyGroup>

  <!-- SptRoot = main 4.1 dev install (references + deploy). FikaSptRoot = the Fika
       dev install, only the Fika compat project needs it for Fika.Core.dll. -->
  <PropertyGroup>
    <SptRoot Condition="'$(SptRoot)' == ''">D:\SPT41Dev</SptRoot>
    <FikaSptRoot Condition="'$(FikaSptRoot)' == ''">D:\SPT41DevFika</FikaSptRoot>
    <SptServerDir>$(SptRoot)\SPT_Runtime</SptServerDir>
  </PropertyGroup>
</Project>
